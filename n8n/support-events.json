        "text": "=💸 <b>Refund issued</b> ({{ $json.body.engine }})\nOrder {{ String(($json.body.args || {}).orderId ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;') }}: {{ String(($json.body.args || {}).amountEur ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;') }} EUR\nReason: {{ String(($json.body.args || {}).reason ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;') }}",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      }
    },
    {
      "id": "6f1c2a10-0005-4a8e-9b1a-000000000005",
      "name": "Telegram: security alert",
